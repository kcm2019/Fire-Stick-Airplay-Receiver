<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- HLS / URL playback. Kept GONE unless AirPlay video (/play) is showing. -->
    <SurfaceView
        android:id="@+id/hlsSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Screen mirroring. A MediaPlayer on the HLS surface above and a
         MediaCodec on this one can never collide: a Surface's buffer queue
         refuses a second MEDIA producer, which was the v1.0.9 black screen. -->
    <SurfaceView
        android:id="@+id/playerSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Info + controls overlay: shows on connect for 10 s, reappears on
         remote interaction, then auto-hides. -->
    <TextView
        android:id="@+id/statsView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="22dp"
        android:background="#99000000"
        android:fontFamily="monospace"
        android:lineSpacingMultiplier="1.25"
        android:padding="12dp"
        android:textColor="#E8E8E8"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/playerOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="#B3141416">

        <TextView
            android:id="@+id/playerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AirPlay Receiver"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting…"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/playerControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏸ Pause"
                android:textSize="13sp"
                android:focusable="true"
                android:background="@drawable/button_focusable"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="⚙ Settings"
                android:textSize="13sp"
                android:focusable="true"
                android:background="@drawable/button_focusable"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="⏹ Stop"
                android:textSize="13sp"
                android:focusable="true"
                android:background="@drawable/button_focusable"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- In-player settings (only display mode for now). -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#E61D1D22"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="17sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDisplayMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Display: Fit (keep aspect ratio)"
            android:textSize="14sp"
            android:focusable="true"
                android:background="@drawable/button_focusable"
                android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stats: Off"
            android:textSize="14sp"
            android:focusable="true"
                android:background="@drawable/button_focusable"
                android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnFade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Menu fade: 10s"
            android:textSize="14sp"
            android:focusable="true"
                android:background="@drawable/button_focusable"
                android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBrightnessDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brightness −"
                android:textSize="14sp"
                android:focusable="true"
                android:background="@drawable/button_focusable"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/brightnessLabel"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Auto"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnBrightnessUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brightness +"
                android:textSize="14sp"
                android:focusable="true"
                android:background="@drawable/button_focusable"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCloseSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Close"
            android:textSize="14sp"
            android:focusable="true"
                android:background="@drawable/button_focusable"
                android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
